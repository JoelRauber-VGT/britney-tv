# Kopieren nach news_pipeline/.env und ausfüllen. .env ist gitignored.
OPENAI_API_KEY=sk-...
# Modelle (optional, sonst Defaults)
LLM_MODEL=gpt-5.4-mini
IMAGE_MODEL=gpt-image-1-mini
IMAGE_QUALITY=medium
MAX_NEW_IMAGES_PER_RUN=8
# Zielordner für news.json + Bilder (relativ zum Repo oder absolut)
OUTPUT_DIR=data
