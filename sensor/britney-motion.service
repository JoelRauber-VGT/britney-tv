[Unit]
Description=Britney PIR Motion (BS412 -> Kiosk: Leertaste/Video weiter)
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=britney-tv
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/britney-tv/.Xauthority
WorkingDirectory=/home/britney-tv/britney-tv
ExecStart=/usr/bin/python3 /home/britney-tv/britney-tv/sensor/bs412_motion.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
